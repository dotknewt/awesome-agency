{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh"
            ],
            "timeout": 10,
            "statusMessage": "Loading vault briefing"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/session-capture.mjs",
              "stop"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/session-capture.mjs",
              "postcompact"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/session-capture.mjs",
              "sessionend"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/vault-lint.mjs",
              "pre"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__obsidian__(write_note|move_note|move_file|update_frontmatter|patch_note|manage_tags|delete_note)",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/vault-lint.mjs",
              "pre"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/vault-lint.mjs",
              "post"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__obsidian__(write_note|move_note|move_file|update_frontmatter|patch_note|manage_tags)",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/vault-lint.mjs",
              "post"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
