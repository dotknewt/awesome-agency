{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "respectGitignore": true,
  "env": {
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "CLAUDE_CODE_ENABLE_TOKEN_USAGE_ATTACHMENT": "1",
    "CLAUDE_CODE_NEW_INIT": "1",
    "CLAUDE_CODE_PLAN_MODE_INTERVIEW_PHASE": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "permissions": {
    "allow": [
      "mcp__obsidian__*",
      "Edit(/vault/**)",
      "Bash(node .claude/hooks/vault-lint.mjs *)",
      "Bash(python3 -m json.tool .claude-plugin/marketplace.json)",
      "Bash(python3 -m json.tool .claude/settings.json)"
    ],
    "ask": [
      "mcp__obsidian__delete_note"
    ]
  },
  "enabledPlugins": {
    "superpowers@awesome-agency": true
  },
  "plansDirectory": "vault/plans",
  "autoMemoryEnabled": false,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "model": "sonnet",
  "worktree": {
    "baseRef": "fresh"
  },
  "enableWorkflows": true,
  "effortLevel": "medium",
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": false,
  "enabledMcpjsonServers": [
    "obsidian",
    "context7"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh"
            ],
            "timeout": 10,
            "statusMessage": "Loading vault briefing"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-capture.mjs",
              "stop"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-capture.mjs",
              "postcompact"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-capture.mjs",
              "sessionend"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/vault-lint.mjs",
              "pre"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__obsidian__(write_note|move_note|move_file|update_frontmatter|patch_note|manage_tags|delete_note)",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/vault-lint.mjs",
              "pre"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/vault-lint.mjs",
              "post"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__obsidian__(write_note|move_note|move_file|update_frontmatter|patch_note|manage_tags)",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/vault-lint.mjs",
              "post"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
