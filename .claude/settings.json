{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "respectGitignore": true,
  "env": {
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "CLAUDE_CODE_ENABLE_TOKEN_USAGE_ATTACHMENT": "1",
    "CLAUDE_CODE_NEW_INIT": "1",
    "CLAUDE_CODE_PLAN_MODE_INTERVIEW_PHASE": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "permissions": {
    "allow": [
      "mcp__obsidian__*",
      "Edit(/vault/**)",
      "Bash(node plugins/vault-memory/hooks/vault-lint.mjs *)",
      "Bash(python3 -m json.tool .claude-plugin/marketplace.json)",
      "Bash(python3 -m json.tool .claude/settings.json)"
    ],
    "ask": [
      "mcp__obsidian__delete_note"
    ]
  },
  "enabledPlugins": {
    "superpowers@awesome-agency": true,
    "vault-memory@awesome-agency": true
  },
  "plansDirectory": "vault/plans",
  "autoMemoryEnabled": false,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "model": "sonnet",
  "worktree": {
    "baseRef": "fresh"
  },
  "enableWorkflows": true,
  "effortLevel": "medium",
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": false,
  "enabledMcpjsonServers": [
    "context7"
  ]
}
